# Скопируйте в корень репозитория как `.env` и подставьте значения.
# Docker Compose читает `.env` из текущей рабочей директории (обычно корень проекта).

SECRET_KEY=замените-на-длинную-случайную-строку

# Режим БД в контейнере web: postgres (рекомендуется для этого compose)
DB_DRIVER=postgres

# Должен совпадать с POSTGRES_* ниже (логин, пароль, имя БД, хост postgres — имя сервиса)
DATABASE_URL=postgresql://nikacrm:change-me@postgres:5432/nikacrm

POSTGRES_DB=nikacrm
POSTGRES_USER=nikacrm
POSTGRES_PASSWORD=change-me

# Gunicorn (docker-entrypoint.sh). WORK ~2 CPU: 4×6; DEMO ~1 ГБ: 2×4
WEB_CONCURRENCY=3
WEB_THREADS=4
# Recycle воркеров (entrypoint defaults 1500 / 150)
# GUNICORN_MAX_REQUESTS=1500
# GUNICORN_MAX_REQUESTS_JITTER=150

# Пул Postgres на процесс gunicorn (× WEB_CONCURRENCY < max_connections)
PG_POOL_MINCONN=2
PG_POOL_MAXCONN=8

# Redis (кэш / rate limit / Socket.IO message_queue). Compose поднимает redis:7-alpine.
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/1

# Почта (SMTP) — можно оставить пустым и заполнить в CRM Настройки → Почта.
# Логин: ваш@email.ru
# От кого: Название вашей компании <ваш@email.ru> — email внутри <> = логин
# Полный шаблон: scripts/templates/mail.env.snippet и корневой .env.example
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_TIMEOUT=15

# Опционально: VAPID для Web Push чата — см. корневой `.env.example`
