# NikaNewCrm — Production
# Скопируйте в .env и заполните значения

# Обязательно! Сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-min-32-chars

# Режим (production)
FLASK_ENV=production

# Драйвер БД: только postgres (политика проекта)
DB_DRIVER=postgres

# PostgreSQL DSN (если DB_DRIVER=postgres)
# Формат: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://nikacrm:change-me@postgres:5432/nikacrm
# Пул соединений PostgreSQL (ускоряет многократные запросы)
PG_POOL_MINCONN=2
PG_POOL_MAXCONN=8

# Redis: кэш, Flask-Limiter, Socket.IO и общий lockout входа между gunicorn-воркерами
# REDIS_URL=redis://127.0.0.1:6379/0
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/1

# Rate limit (memory:// для одного процесса; redis:// для нескольких воркеров)
RATELIMIT_STORAGE_URI=memory://
WRITE_API_RATE_LIMIT_PER_MIN=120

# Host header allowlist (через запятую, без схемы). В production список обязателен — пустой не допускается.
TRUSTED_HOSTS=localhost,127.0.0.1
# Токен @private разрешает любой private/loopback/link-local IP (LAN при DHCP):
# TRUSTED_HOSTS=localhost,127.0.0.1,@private
# На WORK: TRUSTED_HOSTS=crm.nika-sc.ru,localhost,127.0.0.1
# Важно при Docker: переменные выше (TRUSTED_HOSTS, SOCKETIO_*) должны попадать в процесс web.
# В этом репозитории они перечислены в docker/docker-compose.yml → services.web.environment.
# Если клонировали шаблон без этих строк — добавьте их в compose, иначе за nginx будет 400 invalid_host.
# Для systemd/gunicorn достаточно EnvironmentFile=.env (все ключи из .env видны приложению).

# CSP: report-only legacy UI; strict nonce policy (see CSP_NONCE_MODE)
CSP_REPORT_ONLY=false
# off | report (default) | enforce — strict CSP without unsafe-inline
CSP_NONCE_MODE=report
# Точечный enforcement (логин и API). Пустое значение в коде по умолчанию: /login,/portal/login,/api/,/portal/api/
CSP_ENFORCE_PATH_PREFIXES=/login,/portal/login,/api/,/portal/api/
# Опционально URL сборщика CSP-репортов
CSP_REPORT_URI=

# Email OTP after password (future release; disabled)
STAFF_EMAIL_OTP_ENABLED=false

# HTTPS: на проде за TLS обязательно true — Secure-cookie сессии
USE_HTTPS=true

# Brute-force lockout (staff login)
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_SEC=600
LOGIN_LOCKOUT_DURATION_SEC=1800

# Brute-force lockout (portal login)
PORTAL_LOGIN_LOCKOUT_THRESHOLD=8
PORTAL_LOGIN_LOCKOUT_WINDOW_SEC=600
PORTAL_LOGIN_LOCKOUT_DURATION_SEC=1800

# Часовой пояс (3 = Москва)
TIMEZONE_OFFSET=3

# =============================================================================
# Настройки для отправки писем клиентам (SMTP)
# Заполните значения ниже. Файл .env не попадает в git.
# Можно оставить пустым и заполнить в CRM: Настройки → Общие → Почта (SMTP).
# При сохранении почты в CRM эти ключи обновляются здесь (если .env найден).
# Шаблон: scripts/templates/mail.env.snippet
# =============================================================================

# Адрес SMTP-сервера (например: smtp.gmail.com, smtp.yandex.ru, smtp.mail.ru)
MAIL_SERVER=

# Порт: обычно 587 (TLS) или 465 (SSL)
MAIL_PORT=587

# Использовать TLS (для порта 587 — True)
MAIL_USE_TLS=True

# Использовать SSL (для порта 465 — True, тогда MAIL_USE_TLS=False)
MAIL_USE_SSL=False

# Логин SMTP — полный email ящика (ваш@email.ru), не noreply@example.com
MAIL_USERNAME=

# Пароль: для Gmail/Яндекс/Mail.ru — «пароль приложения», не обычный пароль от почты
MAIL_PASSWORD=

# От кого уходят письма. В .env обычно mailbox (ASCII); полное имя — в CRM.
# В CRM Настройки → Почта вставьте: Название вашей компании <ваш@email.ru>
# (email внутри <> = тот же, что MAIL_USERNAME / логин).
MAIL_DEFAULT_SENDER=

# Таймаут соединения с SMTP в секундах (на Windows / слабом канале лучше 15, не 3)
MAIL_TIMEOUT=15

# Публичный адрес CRM для тега ##PORTAL_URL## в письме «Заказ принят»
# (ссылка на /portal/login). Письмо уходит фоном, без request-контекста,
# поэтому адрес задаётся явно. Если не задать, берётся первый домен из TRUSTED_HOSTS.
# PORTAL_PUBLIC_URL=https://crm.example.com

# Web Push (чат сотрудников, вкладка может быть закрыта). Опционально.
# Сгенерировать ключи: python scripts/generate_staff_chat_vapid_keys.py
# Или одноразово дописать в .env: python scripts/ensure_staff_chat_vapid_env.py
# STAFF_CHAT_VAPID_PUBLIC_KEY=
# STAFF_CHAT_VAPID_PRIVATE_KEY=   # PEM в одной строке, переводы как \n
# STAFF_CHAT_VAPID_CLAIM_EMAIL=mailto:admin@example.com

# Публичное демо / SEO-лендинг — только на demo-VPS, на боевом CRM не включать.
# PUBLIC_LANDING=1
# PUBLIC_LANDING_CANONICAL=https://service.nika-crm.ru
# (legacy demo host: https://demo.nika-sc.ru — redirect to service. after cutover)
# DEMO_LOGIN_BANNER=1
# На публичном демо (DEMO_LOGIN_BANNER=1) исходящая SMTP из CRM выключена (антиспам).
# Бэкапы на email с хоста (backup_and_email.sh) — отдельно, не Flask-Mail.
# Self-hosted / рабочий CRM: почта включена. Явно выключить: MAIL_SENDING_ENABLED=false
# MAIL_SENDING_ENABLED=true
# DEMO_LOGIN_USERNAME_HINT=demo_admin
# DEMO_LOGIN_PASSWORD_HINT=Demo2026!
# DEMO_SERVER_SPEC=Одна строка или несколько через \n в значении переменной
# DEMO_VISITOR_STATS=1
#
# Реферал VPS (панель демо-входа; по умолчанию FirstVDS)
# REFERRAL_VPS_PROVIDER_LABEL=FirstVDS
# REFERRAL_VPS_URL=https://firstvds.ru/?from=528402
# REFERRAL_VPS_PROMO_CODE=648528402
