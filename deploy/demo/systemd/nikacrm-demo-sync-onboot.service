[Unit]
Description=Подтянуть демо CRM с GitHub (OSS main) перед стартом приложения
Documentation=file:///root/Nika-Service-CRM/deploy/demo/README.md
After=network-online.target postgresql.service
Wants=network-online.target
Before=nikacrm.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/nikacrm-demo-sync
ExecStart=/usr/local/sbin/nikacrm-demo-sync.sh boot

[Install]
WantedBy=multi-user.target
