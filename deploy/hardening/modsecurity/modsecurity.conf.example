# ModSecurity for host nginx — DetectionOnly by default.
# Install: apt install libnginx-mod-http-modsecurity modsecurity-crs
# Merge snippet from deploy/hardening/nginx/modsecurity-snippet.conf.example

SecRuleEngine DetectionOnly
SecRequestBodyAccess On
SecResponseBodyAccess Off
SecAuditEngine RelevantOnly
SecAuditLog /var/log/nginx/modsec_audit.log
SecAuditLogParts ABIJDEFHZ
SecAuditLogType Serial

Include /etc/modsecurity/crs/crs-setup.conf
Include /etc/modsecurity/crs/rules/*.conf

# CRM: large JSON/multipart — tune after audit review
SecRequestBodyLimit 13107200
SecRequestBodyNoFilesLimit 131072
